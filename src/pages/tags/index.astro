---
import Layout from "../../layouts/Layout.astro";
import { getAllTags } from "../../utils/posts";

const tags = await getAllTags();
---

<Layout
  title="Tagi — Zając na Froncie"
  description="Wszystkie tematy na blogu Zając na Froncie — wybierz tag, żeby zobaczyć powiązane wpisy."
>
  <h1 class="mb-6 text-3xl font-bold text-slate-900 dark:text-slate-100">
    Tagi
  </h1>

  <ul class="flex flex-wrap gap-3">
    {tags.map(({ tag, count }) => (
      <li>
        <a
          href={`/tags/${tag}`}
          class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 px-4 py-1.5 text-sm font-medium text-accent-dark transition hover:bg-accent/20 dark:bg-accent/20 dark:text-accent dark:hover:bg-accent/30"
        >
          #{tag}
          <span class="text-xs text-slate-500 dark:text-slate-400">
            {count}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
