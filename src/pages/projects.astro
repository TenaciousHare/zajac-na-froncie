---
import Layout from "../layouts/Layout.astro";
import Wiersz from "../components/Wiersz.astro";
import Kwadraty from "../components/Kwadraty.astro";
import type { KluczSerii } from "../data/serie";
import { getSeriesOverview, odmien } from "../utils/posts";

type Projekt = {
  name: string;
  description: string;
  tech: string[];
  live: string;
  repo: string;
  /** seria z warsztatu, w której opisuję budowę projektu */
  seria?: KluczSerii;
};

const projects: Projekt[] = [
  {
    name: "Avia Weather",
    description:
      "Pogoda lotnicza METAR & TAF — surowe depesze tłumaczone na ludzki język. Dane przez TanStack Query, klucz API ukryty w funkcji serwerowej Netlify.",
    tech: [
      "React",
      "TypeScript",
      "Vite",
      "TanStack Query",
      "Vitest",
      "Netlify Functions",
    ],
    live: "https://avia-weather.netlify.app",
    repo: "https://github.com/TenaciousHare/Avia-Weather",
    seria: "jak-powstal-metar",
  },
  {
    name: "Destinations",
    description:
      "Generator losowych testów z kierunków (kody IATA) dla obsługi naziemnej — panel szkoleniowca za logowaniem (Firebase Auth), dane w Firestore, trasy chronione React Routerem.",
    tech: ["React", "TypeScript", "Vite", "React Router", "Firebase", "Vitest"],
    live: "https://destinations-test.netlify.app",
    repo: "https://github.com/TenaciousHare/Destinations",
    seria: "jak-powstal-destinations",
  },
  {
    name: "ManualBoarding",
    description:
      "Trener manualnego boardingu dla obsługi lotu — procedura krok po kroku, z testami jednostkowymi (Vitest) i E2E (Playwright).",
    tech: ["React", "TypeScript", "Vite", "Vitest", "Playwright"],
    live: "https://manual-boarding.netlify.app",
    repo: "https://github.com/TenaciousHare/ManualBoarding",
  },
  {
    name: "Zając na Froncie",
    description:
      "Ten blog: podstawy HTML, CSS i JavaScriptu na prawdziwym kodzie, z Senior Hare na marginesie.",
    tech: ["Astro", "MDX", "Tailwind", "TypeScript"],
    live: "https://zajac-na-froncie.netlify.app",
    repo: "https://github.com/TenaciousHare/zajac-na-froncie",
  },
];

const serie = await getSeriesOverview();
const czesci = (n: number) =>
  odmien(n, { one: "część", few: "części", many: "części" });

const link =
  "font-semibold text-dlugopis underline decoration-linia underline-offset-3 hover:text-dlugopis-ciemny hover:decoration-dlugopis";
---

<Layout
  title="Projekty — Zając na Froncie"
  description="Realne narzędzia webowe z pogranicza lotnictwa i frontendu: Avia Weather, Destinations, ManualBoarding i ten blog. React, TypeScript, Astro."
>
  <!-- -my-8 znosi py-8 z <main>, więc linia marginesu dochodzi do nagłówka i stopki -->
  <div class="zeszyt -my-8 pb-16 [--margines:1rem] md:[--margines:5.5rem]">
    <Wiersz class="pt-12 md:pt-16">
      <h1 class="text-[clamp(2.4rem,4.4vw,3.25rem)] leading-tight font-extrabold tracking-tight">
        Projekty
      </h1>
      <p class="mt-3 max-w-[40em] text-lg text-pretty text-atrament-2">
        Narzędzia, które wyrosły z mojej pracy w lotnictwie — każde rozwiązuje
        realny problem i każde jest na żywo.
      </p>
    </Wiersz>

    <Wiersz class="mt-12">
      <div class="grid gap-x-14 gap-y-14 md:grid-cols-2">
        {projects.map((p) => {
          const seria = serie.find((s) => s.klucz === p.seria);
          return (
            <article class="flex flex-col gap-3">
              <h2 class="text-[1.6rem] leading-tight font-extrabold tracking-tight">
                {p.name}
              </h2>
              <p class="text-pretty text-atrament-2">{p.description}</p>
              <p class="text-sm text-olowek">{p.tech.join(", ")}</p>
              <p class="flex flex-wrap gap-x-6 gap-y-2">
                <a href={p.live} target="_blank" rel="noopener" class={link}>
                  Zobacz na żywo
                  <span class="sr-only"> (otwiera się w nowej karcie)</span>
                </a>
                <a href={p.repo} target="_blank" rel="noopener" class={link}>
                  Kod na GitHubie
                  <span class="sr-only"> (otwiera się w nowej karcie)</span>
                </a>
              </p>
              {seria && (
                <div class="mt-2 flex flex-col gap-2">
                  <p class="text-sm text-olowek">
                    Jak powstawał: {czesci(seria.czesci.length)} na blogu
                  </p>
                  <Kwadraty
                    tytulSerii={seria.tytul}
                    czesci={seria.czesci}
                    wkrotce={seria.wkrotce}
                  />
                </div>
              )}
            </article>
          );
        })}
      </div>
    </Wiersz>
  </div>
</Layout>
