---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImg from "../assets/SeniorHareHero.png";
---

<Layout
  title="Zając na Froncie - frontent od zera"
  description="Nauka frontendu od podstaw z komiksowym Senior Hare. React, TypeScript, Astro i CSS — po polsku, krok po kroku."
>
  <section class="flex flex-col items-center gap-8 md:flex-row md:justify-between">
    <div>
      <h1 class="text-4xl font-bold text-slate-900">Zając na Froncie</h1>
      <p class="mt-4 text-lg text-slate-600">
        Frontend od zera — z Senior Hare w roli przewodnika.
      </p>
      <a
        href="/blog"
        class="mt-6 inline-block rounded-lg bg-brand px-5 py-3 font-medium text-white hover:bg-brand-dark"
      >
        Czytaj blog
      </a>
    </div>

    <Image
      src={heroImg}
      alt="Senior Hare — zając-senior programista"
      class="w-64 md:w-80"
    />
  </section>
</Layout>
