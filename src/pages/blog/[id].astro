---
import { render } from "astro:content";
import {
  getPublishedPosts,
  getSeriesNav,
  getSeriesParts,
} from "../../utils/posts";
import SeriesParts from "../../components/SeriesParts.astro";
import Layout from "../../layouts/Layout.astro";
import Comments from "../../components/Comments.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import CodeCopy from "../../components/CodeCopy.astro";
import TagList from "../../components/TagList.astro";

// 1. Powiedz Astro, jakie strony zbudować — po jednej na wpis
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

// 2. Odbierz przekazany wpis i wyrenderuj jego Markdown
const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);

// Pobranie innych części wpisu, jeśli istnieją
const { prev, next } = await getSeriesNav(post);
const seriesParts = await getSeriesParts(post);
---

<Layout
  title={`${post.data.title} — Zając na Froncie`}
  description={post.data.description}
>
  <!-- relative: punkt odniesienia dla bocznego spisu treści (desktop) -->
  <div class="relative">
    <article
      class="prose prose-slate dark:prose-invert
  prose-a:text-link prose-a:underline prose-a:underline-offset-2
  prose-a:hover:decoration-2"
    >
      <h1>{post.data.title}</h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        {post.data.pubDate.toLocaleDateString("pl-PL")} ·{" "}
        {remarkPluginFrontmatter.minutesRead} min czytania
      </p>
      <TableOfContents headings={headings} />
      <Content />
    </article>
    <TableOfContents headings={headings} variant="sidebar" />
  </div>
  <TagList tags={post.data.tags} />
  <CodeCopy />
  <SeriesParts parts={seriesParts} currentId={post.id} />
  <SeriesNav prev={prev} next={next} />
  <Comments />
</Layout>
