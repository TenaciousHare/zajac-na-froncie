---
import { render } from "astro:content";
import { getPublishedPosts, getSeriesNav } from "../../utils/posts";
import Layout from "../../layouts/Layout.astro";
import Comments from "../../components/Comments.astro";
import SeriesNav from "../../components/SeriesNav.astro";

// 1. Powiedz Astro, jakie strony zbudować — po jednej na wpis
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

// 2. Odbierz przekazany wpis i wyrenderuj jego Markdown
const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

// Pobranie innych części wpisu, jeśli istnieją
const { prev, next } = await getSeriesNav(post);
---

<Layout
  title={`${post.data.title} — Zając na Froncie`}
  description={post.data.description}
>
  <article class="prose prose-slate prose-a:text-accent hover:prose-a:text-accent-dark prose-a:no-underline hover:prose-a:underline dark:prose-invert">
    <h1>{post.data.title}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">
      {post.data.pubDate.toLocaleDateString("pl-PL")} ·{" "}
      {remarkPluginFrontmatter.minutesRead} min czytania
    </p>
    <Content />
  </article>
  <SeriesNav prev={prev} next={next} />
  <Comments />
</Layout>
