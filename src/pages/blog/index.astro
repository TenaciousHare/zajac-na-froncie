---
import PostCard from "../../components/PostCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
---

<Layout
  title="Blog — Zając na Froncie"
  description="Wpisy o nauce frontendu od zera: React, TypeScript, Astro i CSS. Realna droga z błędami i zwycięstwami — prosto, po polsku, z Senior Hare w roli przewodnika."
>
  <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 mb-6">
    Blog
  </h1>

  <ul class="space-y-6">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </ul>
</Layout>
