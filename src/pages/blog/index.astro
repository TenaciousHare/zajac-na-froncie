---
import Layout from "../../layouts/Layout.astro";
import { getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
---

<Layout
  title="Blog — Zając na Froncie"
  description="Wpisy o nauce frontendu od zera: React, TypeScript, Astro i CSS. Realna droga z błędami i zwycięstwami — prosto, po polsku, z Senior Hare w roli przewodnika."
>
  <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 mb-6">
    Blog
  </h1>

  <ul class="space-y-6">
    {posts.map((post) => (
      <li>
        <a
          href={`/blog/${post.id}`}
          class="group block rounded-xl border border-slate-200 p-6 transition hover:shadow-md hover:-translate-y-0.5 hover:border-accent dark:border-slate-700 dark:bg-slate-800"
        >
          <h2 class="text-xl font-semibold text-slate-900 group-hover:text-accent dark:text-slate-100">
            {post.data.title}
          </h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            {post.data.pubDate.toLocaleDateString("pl-PL")}
          </p>
          <p class="mt-2 text-slate-700 dark:text-slate-300">
            {post.data.description}
          </p>
          {post.data.tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <li class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent-dark dark:bg-accent/20 dark:text-accent">
                  #{tag}
                </li>
              ))}
            </ul>
          )}
        </a>
      </li>
    ))}
  </ul>
</Layout>
