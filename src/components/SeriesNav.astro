---
import type { CollectionEntry } from "astro:content";

interface Props {
  prev?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="not-prose mt-12 grid grid-cols-2 gap-4 border-t border-slate-200 pt-6 dark:border-slate-700">
    {prev ? (
      <a
        href={`/blog/${prev.id}`}
        class="group flex flex-col rounded-lg border border-slate-200 p-4 transition-colors hover:border-accent dark:border-slate-700"
      >
        <span class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
          ← Poprzednia część
        </span>
        <span class="mt-1 font-medium text-slate-900 group-hover:text-accent dark:text-slate-100">
          {prev.data.title}
        </span>
      </a>
    ) : (
      <span></span>
    )}

    {next ? (
      <a
        href={`/blog/${next.id}`}
        class="group flex flex-col rounded-lg border border-slate-200 p-4 text-right transition-colors hover:border-accent dark:border-slate-700"
      >
        <span class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
          Następna część →
        </span>
        <span class="mt-1 font-medium text-slate-900 group-hover:text-accent dark:text-slate-100">
          {next.data.title}
        </span>
      </a>
    ) : (
      <span></span>
    )}
  </nav>
)}
