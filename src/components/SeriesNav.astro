---
import type { CollectionEntry } from "astro:content";

interface Props {
  prev?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav
    aria-label="Części serii"
    class="not-prose mt-12 grid grid-cols-2 gap-4 border-t pt-6 border-linia"
  >
    {prev ? (
      <a
        href={`/blog/${prev.id}`}
        class="group flex flex-col rounded-lg border p-4 transition-colors border-linia hover:border-dlugopis"
      >
        <span class="text-xs uppercase tracking-wide text-olowek">
          <span aria-hidden="true">←</span> Poprzednia część
        </span>
        <span class="mt-1 font-medium text-atrament group-hover:text-dlugopis-ciemny">
          {prev.data.title}
        </span>
      </a>
    ) : (
      <span></span>
    )}

    {next ? (
      <a
        href={`/blog/${next.id}`}
        class="group flex flex-col rounded-lg border p-4 text-right transition-colors border-linia hover:border-dlugopis"
      >
        <span class="text-xs uppercase tracking-wide text-olowek">
          Następna część <span aria-hidden="true">→</span>
        </span>
        <span class="mt-1 font-medium text-atrament group-hover:text-dlugopis-ciemny">
          {next.data.title}
        </span>
      </a>
    ) : (
      <span></span>
    )}
  </nav>
)}
