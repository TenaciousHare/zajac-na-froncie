---
import type { CollectionEntry } from "astro:content";
import { krotkiTytul } from "../utils/posts";

interface Props {
  prev?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { prev, next } = Astro.props;
const karta =
  "group flex flex-col rounded-lg border border-linia p-4 transition-colors hover:border-dlugopis";
---

{(prev || next) && (
  <nav
    aria-label="Sąsiednie części serii"
    class="not-prose mt-12 grid gap-4 border-t border-linia pt-6 sm:grid-cols-2"
  >
    {prev ? (
      <a href={`/blog/${prev.id}`} class={karta}>
        <span class="text-sm text-olowek">Poprzednia część</span>
        <span class="mt-1 font-semibold text-atrament group-hover:text-dlugopis">
          {krotkiTytul(prev)}
        </span>
      </a>
    ) : (
      <span class="hidden sm:block"></span>
    )}

    {next && (
      <a href={`/blog/${next.id}`} class:list={[karta, "sm:text-right"]}>
        <span class="text-sm text-olowek">Następna część</span>
        <span class="mt-1 font-semibold text-atrament group-hover:text-dlugopis">
          {krotkiTytul(next)}
        </span>
      </a>
    )}
  </nav>
)}
