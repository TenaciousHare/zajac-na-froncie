---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
---

<li>
  <article class="group relative rounded-xl border border-slate-200 p-6 transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md dark:border-slate-700 dark:bg-slate-800 focus-within:border-accent">
    <h2 class="text-xl font-semibold text-slate-900 group-hover:text-link group-focus-within:text-link dark:text-slate-100">
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
      {post.data.pubDate.toLocaleDateString("pl-PL")}
    </p>
    <p class="mt-2 text-slate-700 dark:text-slate-300">
      {post.data.description}
    </p>
    <TagList tags={post.data.tags} />
  </article>
</li>
