---
import type { CollectionEntry } from "astro:content";
import TagList from "./TagList.astro";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
---

<li>
  <article class="group relative rounded-xl border border-linia bg-kartka p-6 transition hover:-translate-y-0.5 hover:border-dlugopis hover:shadow-md focus-within:border-dlugopis">
    <h2 class="text-xl font-semibold text-atrament group-hover:text-dlugopis group-focus-within:text-dlugopis">
      <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-1 text-sm text-olowek">
      {post.data.pubDate.toLocaleDateString("pl-PL")}
    </p>
    <p class="mt-2 text-atrament-2">
      {post.data.description}
    </p>
    <TagList tags={post.data.tags} />
  </article>
</li>
