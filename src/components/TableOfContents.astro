---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  /** Minimalna liczba nagłówków, by pokazać spis */
  minHeadings?: number;
}

const { headings, minHeadings = 3 } = Astro.props;

// tylko h2 i h3; trailing "#" ucinamy na wszelki wypadek (gdyby kotwica
// wciekła do tekstu nagłówka przy zbieraniu headings)
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, "").trim() }));
---

<!-- etykieta „W tej lekcji” stoi na marginesie, w [id].astro -->
{toc.length >= minHeadings && (
  <nav aria-label="Spis treści" class="not-prose">
    <ul class="gap-x-8 leading-snug sm:columns-2">
      {toc.map((h) => (
        <li class:list={["break-inside-avoid py-1", h.depth === 3 && "pl-4"]}>
          <a
            href={`#${h.slug}`}
            class="text-dlugopis underline decoration-linia underline-offset-3 hover:text-dlugopis-ciemny hover:decoration-dlugopis"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
