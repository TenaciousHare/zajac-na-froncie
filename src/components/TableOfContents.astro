---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  /** Minimalna liczba nagłówków, by pokazać spis */
  minHeadings?: number;
  /**
   * inline — ramka nad treścią (mobile/tablet),
   * sidebar — przyklejona kolumna z prawej (desktop, od xl)
   */
  variant?: "inline" | "sidebar";
}

const { headings, minHeadings = 3, variant = "inline" } = Astro.props;

// tylko h2 i h3; trailing "#" ucinamy na wszelki wypadek (gdyby kotwica
// wciekła do tekstu nagłówka przy zbieraniu headings)
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, "").trim() }));
---

{toc.length >= minHeadings && variant === "inline" && (
  <nav
    aria-label="Spis treści"
    class="not-prose my-8 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm xl:hidden dark:border-slate-700 dark:bg-slate-800/50"
  >
    <p class="mb-2 font-semibold text-slate-900 dark:text-slate-100">
      Spis treści
    </p>
    <ul class="space-y-1">
      {toc.map((h) => (
        <li class={h.depth === 3 ? "ml-4" : ""}>
          <a
            href={`#${h.slug}`}
            class="text-slate-600 transition hover:text-link dark:text-slate-300"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

{toc.length >= minHeadings && variant === "sidebar" && (
  <aside class="absolute inset-y-0 left-full ml-6 hidden w-52 xl:block">
    <nav
      aria-label="Spis treści"
      data-toc
      class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto text-sm"
    >
      <p class="mb-3 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">
        Spis treści
      </p>
      <ul class="space-y-1 border-l border-slate-200 dark:border-slate-700">
        {toc.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                "-ml-px block border-l-2 border-transparent py-1 pr-2 text-slate-600 hover:text-link motion-safe:transition-colors dark:text-slate-300",
                "aria-[current=location]:border-link aria-[current=location]:font-medium aria-[current=location]:text-link",
                h.depth === 3 ? "pl-7" : "pl-3",
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const links = [
      ...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ];
    // nagłówki w kolejności z dokumentu, sparowane ze swoimi linkami
    const sections = links
      .map((link) => ({
        link,
        heading: document.getElementById(link.dataset.tocLink ?? ""),
      }))
      .filter(
        (s): s is { link: HTMLAnchorElement; heading: HTMLElement } =>
          s.heading !== null,
      );

    let current: HTMLAnchorElement | null = null;
    let ticking = false;

    const setActive = (link: HTMLAnchorElement | null) => {
      if (link === current) return;
      current?.removeAttribute("aria-current");
      link?.setAttribute("aria-current", "location");
      current = link;
      // długi spis: przewiń samą kolumnę, żeby aktywna pozycja była widoczna
      // (nie scrollIntoView — ten potrafi szarpnąć całą stroną)
      if (link) {
        const { offsetTop, offsetHeight } = link;
        if (offsetTop < toc.scrollTop) toc.scrollTop = offsetTop;
        else if (offsetTop + offsetHeight > toc.scrollTop + toc.clientHeight)
          toc.scrollTop = offsetTop + offsetHeight - toc.clientHeight;
      }
    };

    const update = () => {
      // aktywna sekcja = ostatni nagłówek, który minął górne 25% ekranu
      const line = window.innerHeight * 0.25;
      let active: HTMLAnchorElement | null = null;
      for (const { link, heading } of sections) {
        if (heading.getBoundingClientRect().top <= line) active = link;
        else break;
      }
      // na samym dole strony krótka ostatnia sekcja może nie dojechać
      // do linii — wtedy podświetlamy ją na siłę
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      if (atBottom && sections.length) active = sections.at(-1)!.link;

      setActive(active);
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    window.addEventListener("resize", update, { passive: true });
    update();
  }
</script>
