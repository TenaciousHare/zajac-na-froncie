---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  /** Minimalna liczba nagłówków, by pokazać spis */
  minHeadings?: number;
}

const { headings, minHeadings = 3 } = Astro.props;

// tylko h2 i h3; trailing "#" ucinamy na wszelki wypadek (gdyby kotwica
// wciekła do tekstu nagłówka przy zbieraniu headings)
const toc = headings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, "").trim() }));
---

{toc.length >= minHeadings && (
  <nav
    aria-label="Spis treści"
    class="not-prose my-8 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm dark:border-slate-700 dark:bg-slate-800/50"
  >
    <p class="mb-2 font-semibold text-slate-900 dark:text-slate-100">
      Spis treści
    </p>
    <ul class="space-y-1">
      {toc.map((h) => (
        <li class={h.depth === 3 ? "ml-4" : ""}>
          <a
            href={`#${h.slug}`}
            class="text-slate-600 transition hover:text-link dark:text-slate-300"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
