---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<nav class="border-b border-slate-200">
  <div class="mx-auto flex max-w-3xl items-center gap-6 px-4 py-4">
    <a href="/" class="font-semibold text-slate-900 hover:text-brand">
      Zając na Froncie
    </a>
    <a
      href="/blog"
      class:list={[
        "transition hover:text-brand",
        isActive("/blog") ? "text-brand font-semibold" : "text-slate-700",
      ]}
    >
      Blog
    </a>

    <a
      href="/about"
      class:list={[
        "transition hover:text-brand",
        isActive("/about") ? "text-brand font-semibold" : "text-slate-700",
      ]}
    >
      O mnie
    </a>
  </div>
</nav>
