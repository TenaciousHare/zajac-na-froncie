---
import { Image } from "astro:assets";

import explain from "../assets/hare/SeniorHare_1_explanations-tutorial.png";
import code from "../assets/hare/SeniorHare_2_coding.png";
import tip from "../assets/hare/SeniorHare_3_tips_bestPractices.png";
import bug from "../assets/hare/SeniorHare_4_bugs-frustration.png";
import why from "../assets/hare/SeniorHare_5_whyNotWorking.png";
import works from "../assets/hare/SeniorHare_6_itWorks.png";
import debug from "../assets/hare/SeniorHare_7_debugging.png";
import learn from "../assets/hare/SeniorHare_8_learning-newTechnologies.png";
import question from "../assets/hare/SeniorHare_9_questions-concerns.png";
import simple from "../assets/hare/SeniorHare_10_simpleSolutions.png";
import architecture from "../assets/hare/SeniorHare_11_architecture-advanced.png";
import success from "../assets/hare/SeniorHare_12_success.png";
import decision from "../assets/hare/SeniorHare_13_decision.png";

const badges = {
  explain,
  code,
  tip,
  bug,
  why,
  works,
  debug,
  learn,
  question,
  simple,
  architecture,
  success,
  decision,
};
const labels: Record<keyof typeof badges, string> = {
  explain: "Wyjaśnienie",
  code: "Kod",
  tip: "Wskazówka",
  bug: "Bug",
  why: "Dlaczego to nie działa?",
  works: "Działa!",
  debug: "Debugowanie",
  learn: "Nauka",
  question: "Pytanie",
  simple: "Proste rozwiązanie",
  architecture: "Architektura",
  success: "Sukces!",
  decision: "Dlaczego tak?",
};

interface Props {
  type: keyof typeof badges;
}

const { type } = Astro.props;
const img = badges[type];
const label = labels[type];
---

<aside class="not-prose my-6 flex items-center gap-4 rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
  <Image src={img} alt="Senior Hare" class="w-16 shrink-0" />
  <div
    class="text-slate-700 dark:text-slate-300 [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2
  [&_a:hover]:decoration-2 flex-1 min-w-0 [&_pre]:my-3 [&_pre]:rounded-lg [&_pre]:p-4
  [&_kbd]:rounded [&_kbd]:border [&_kbd]:border-b-2 [&_kbd]:border-slate-300 [&_kbd]:bg-white
  [&_kbd]:px-1.5 [&_kbd]:py-0.5 [&_kbd]:font-sans [&_kbd]:text-[0.875em] [&_kbd]:font-medium
  dark:[&_kbd]:border-slate-600 dark:[&_kbd]:bg-slate-700
  [&_:not(pre)>code]:text-[0.875em] [&_:not(pre)>code]:font-semibold [&_:not(pre)>code]:text-slate-900
  dark:[&_:not(pre)>code]:text-slate-100"
  >
    <p class="font-semibold text-slate-900 dark:text-slate-100">{label}</p>
    <slot />
  </div>
</aside>
