---
import { Image } from "astro:assets";

import explain from "../assets/hare/SeniorHare_1_explanations-tutorial.png";
import code from "../assets/hare/SeniorHare_2_coding.png";
import tip from "../assets/hare/SeniorHare_3_tips_bestPractices.png";
import bug from "../assets/hare/SeniorHare_4_bugs-frustration.png";
import why from "../assets/hare/SeniorHare_5_whyNotWorking.png";
import works from "../assets/hare/SeniorHare_6_itWorks.png";
import debug from "../assets/hare/SeniorHare_7_debugging.png";
import learn from "../assets/hare/SeniorHare_8_learning-newTechnologies.png";
import question from "../assets/hare/SeniorHare_9_questions-concerns.png";
import simple from "../assets/hare/SeniorHare_10_simpleSolutions.png";
import architecture from "../assets/hare/SeniorHare_11_architecture-advanced.png";
import success from "../assets/hare/SeniorHare_12_success.png";
import decision from "../assets/hare/SeniorHare_13_decision.png";

const badges = {
  explain,
  code,
  tip,
  bug,
  why,
  works,
  debug,
  learn,
  question,
  simple,
  architecture,
  success,
  decision,
};
const labels: Record<keyof typeof badges, string> = {
  explain: "Wyjaśnienie",
  code: "Kod",
  tip: "Wskazówka",
  bug: "Pułapka",
  why: "Dlaczego to nie działa?",
  works: "Działa!",
  debug: "Debugowanie",
  learn: "Nauka",
  question: "Pytanie",
  simple: "Proste rozwiązanie",
  architecture: "Architektura",
  success: "Sukces!",
  decision: "Dlaczego tak?",
};

interface Props {
  type: keyof typeof badges;
}

const { type } = Astro.props;
const img = badges[type];
const label = labels[type];
// notatka z blokiem kodu albo długa zostaje dymkiem w tekście
const html = await Astro.slots.render("default");
const tekst = html.replace(/<[^>]+>/g, "");
const naMargines = !html.includes("<pre") && tekst.length <= 220;
const ostrzezenie = type === "bug" || type === "why";
---

<!-- div, nie aside: aside wewnątrz <article> i tak nie jest punktem orientacyjnym,
     a axe i Lighthouse zgłaszają go jako zagnieżdżony landmark -->
<div
  data-margines={naMargines ? "" : undefined}
  class="hare not-prose my-6 flex items-start gap-3"
>
  <Image
    src={img}
    alt=""
    width={64}
    densities={[1, 2]}
    class="hare-obrazek w-14 shrink-0"
  />
  <div
    class="dymek relative min-w-0 flex-1 rounded-[1.1rem_0.9rem_1.2rem_0.8rem/0.9rem_1.2rem_0.8rem_1.1rem] border-[1.5px] border-atrament bg-kartka px-4 py-3 font-reka text-[1.0625rem] leading-snug text-atrament [&_a]:text-dlugopis [&_a]:underline [&_a]:underline-offset-2
    [&_a:hover]:text-dlugopis-ciemny [&_a:hover]:decoration-2
    [&_pre]:my-3 [&_pre]:rounded-lg [&_pre]:p-4
    [&_kbd]:rounded [&_kbd]:border [&_kbd]:border-b-2 [&_kbd]:border-linia [&_kbd]:bg-papier
    [&_kbd]:px-1.5 [&_kbd]:py-0.5 [&_kbd]:font-sans [&_kbd]:text-[0.875em] [&_kbd]:font-medium
    [&_:not(pre)>code]:text-[0.875em] [&_:not(pre)>code]:font-semibold [&_:not(pre)>code]:text-atrament"
  >
    <svg
      aria-hidden="true"
      class="ogonek absolute -left-3.5 top-4"
      width="16"
      height="22"
      viewBox="0 0 16 22"
    >
      <path
        d="M15 1 L1 9 L15 17"
        class="fill-kartka stroke-atrament"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <path d="M15.5 2 V16" class="stroke-kartka" stroke-width="3" />
    </svg>
    <p
      class:list={["font-bold", ostrzezenie ? "text-pulapka" : "text-dlugopis"]}
    >
      {label}
    </p>
    <Fragment set:html={html} />
  </div>
</div>
