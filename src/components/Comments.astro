<section class="mt-12">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="TenaciousHare/zajac-na-froncie"
    data-repo-id="R_kgDOU96n1w"
    data-category="Comments"
    data-category-id="DIC_kwDOU96n184DHMkm"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="pl"
    crossorigin="anonymous"
    async
  ></script>
</section>

<script>
  function giscusTheme() {
    return document.documentElement.getAttribute("data-theme") === "dark"
      ? "dark"
      : "light";
  }

  function applyGiscusTheme() {
    const iframe = document.querySelector<HTMLIFrameElement>(
      "iframe.giscus-frame",
    );
    iframe?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: giscusTheme() } } },
      "https://giscus.app",
    );
  }

  // 1. gdy Giscus się załaduje → ustaw aktualny motyw
  addEventListener("message", (event) => {
    if (event.origin !== "https://giscus.app") return;
    if (typeof event.data?.giscus === "undefined") return;
    applyGiscusTheme();
  });

  // 2. gdy motyw strony się zmieni (klik w przełącznik) → zaktualizuj Giscus
  new MutationObserver(applyGiscusTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
