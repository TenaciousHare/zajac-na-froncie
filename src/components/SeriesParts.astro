---
import type { CollectionEntry } from "astro:content";

interface Props {
  parts: CollectionEntry<"blog">[];
  currentId: string;
}

const { parts, currentId } = Astro.props;
---

{parts.length > 1 && (
  <section class="not-prose mt-12 border-t pt-6 border-linia">
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-olowek">
      Więcej z tej serii
    </h2>
    <ol class="space-y-2">
      {parts.map((part) =>
        part.id === currentId ? (
          <li>
            <span
              aria-current="true"
              class="flex gap-3 rounded-lg border border-dlugopis bg-dlugopis/5 p-3 font-medium text-atrament"
            >
              <span class="text-olowek">{part.data.seriesPart}.</span>
              <span>{part.data.title}</span>
            </span>
          </li>
        ) : (
          <li>
            <a
              href={`/blog/${part.id}`}
              class="group flex gap-3 rounded-lg border border-linia p-3 transition-colors hover:border-dlugopis"
            >
              <span class="text-olowek">{part.data.seriesPart}.</span>
              <span class="text-atrament-2 group-hover:text-dlugopis-ciemny">
                {part.data.title}
              </span>
            </a>
          </li>
        ),
      )}
    </ol>
  </section>
)}
