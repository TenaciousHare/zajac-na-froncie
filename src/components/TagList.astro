---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;

// tag z prawie każdego wpisu niczego nie odróżnia, więc go nie pokazujemy
const ukryte = new Set(["podstawy"]);
const widoczne = tags.filter((tag) => !ukryte.has(tag));
---

{widoczne.length > 0 && (
  <ul class="relative z-10 mt-3 flex flex-wrap gap-2">
    {widoczne.map((tag) => (
      <li>
        <a
          href={`/tags/${tag}`}
          class="inline-block rounded-full bg-dlugopis/10 px-3 py-1 text-xs font-medium text-dlugopis transition hover:bg-dlugopis/20"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
