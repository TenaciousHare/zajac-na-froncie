---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="relative z-10 mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tag}`}
          class="inline-block rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent-dark transition hover:bg-accent/20 dark:bg-accent/20 dark:text-accent dark:hover:bg-accent/30"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
